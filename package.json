{
  "name": "veena-engine",
  "version": "0.1.0",
  "description": "Veena is a deterministic, code-first animation engine built on the web platform.",
  "keywords": ["animation", "video", "deterministic", "motion-graphics", "three", "murali"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "import": "./dist/index.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "import": "./dist/render/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./style": {
      "types": "./dist/style/index.d.ts",
      "import": "./dist/style/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./layout": {
      "types": "./dist/tattvas/layout/index.d.ts",
      "import": "./dist/tattvas/layout/index.js"
    },
    "./primitives": {
      "types": "./dist/tattvas/primitives/index.d.ts",
      "import": "./dist/tattvas/primitives/index.js"
    },
    "./text": {
      "types": "./dist/tattvas/text/index.d.ts",
      "import": "./dist/tattvas/text/index.js"
    },
    "./maths": {
      "types": "./dist/tattvas/maths/index.d.ts",
      "import": "./dist/tattvas/maths/index.js"
    },
    "./ai": {
      "types": "./dist/tattvas/ai/index.d.ts",
      "import": "./dist/tattvas/ai/index.js"
    },
    "./composite": {
      "types": "./dist/tattvas/composite/index.d.ts",
      "import": "./dist/tattvas/composite/index.js"
    },
    "./storytelling": {
      "types": "./dist/tattvas/storytelling/index.d.ts",
      "import": "./dist/tattvas/storytelling/index.js"
    },
    "./table": {
      "types": "./dist/tattvas/table/index.d.ts",
      "import": "./dist/tattvas/table/index.js"
    },
    "./utility": {
      "types": "./dist/tattvas/utility/index.d.ts",
      "import": "./dist/tattvas/utility/index.js"
    }
  },
  "bin": { "veena": "dist/cli.js" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murali-engine/veena.git"
  },
  "homepage": "https://veenaengine.com",
  "bugs": {
    "url": "https://github.com/murali-engine/veena/issues"
  },
  "files": ["dist", "README.md"],
  "workspaces": ["examples", "docs"],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "render": "npm run build --silent && node dist/cli.js render",
    "example": "npm run build --silent && node scripts/run-example.mjs",
    "docs:start": "npm --workspace @veena/docs run start",
    "docs:build": "npm --workspace @veena/docs run build",
    "docs:serve": "npm --workspace @veena/docs run serve",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "test:package": "node scripts/package-smoke.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build && npm test"
  },
  "dependencies": {
    "@playwright/browser-chromium": "1.64.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.180.0",
    "commander": "^14.0.3",
    "esbuild": "^0.28.2",
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.180.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  },
  "allowScripts": {
    "@playwright/browser-chromium": true,
    "core-js": true,
    "esbuild": true,
    "ffmpeg-static": true,
    "fsevents": true
  },
  "engines": { "node": ">=20" },
  "publishConfig": { "access": "public" }
}
